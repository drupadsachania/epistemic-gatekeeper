# Production Environment Configuration
NODE_ENV=production
VITE_API_URL=https://api.kairos-ecl.com
VITE_ANALYTICS_ENABLED=true
VITE_ERROR_TRACKING_ENABLED=true
VITE_SERVICE_WORKER_ENABLED=true
VITE_DEBUG_MODE=false

# API Configuration
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# Analytics & Monitoring
VITE_SENTRY_DSN=https://your-sentry-key@sentry.io/your-project-id
VITE_ANALYTICS_ID=UA-XXXXXXXXX-X
VITE_SESSION_TIMEOUT=3600000

# Feature Flags
VITE_FEATURE_RESEARCH_SECTION=true
VITE_FEATURE_ADOPTION_SECTION=true
VITE_FEATURE_INTERACTIVE_PAGE=true
VITE_FEATURE_OFFLINE_MODE=true

# Security
VITE_CORS_ORIGIN=https://kairos-ecl.com
VITE_CSP_HEADER=true
